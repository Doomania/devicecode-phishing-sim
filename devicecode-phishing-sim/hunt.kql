// ============================================================
// Device Code Phishing — KQL Hunting Query Pack
// Target: Microsoft Sentinel / Entra ID / Log Analytics
// Reference: RFC 8628 abuse, MITRE ATT&CK T1528
// ============================================================


// ── QUERY 1 ─────────────────────────────────────────────────
// Baseline: All device code sign-ins (last 7 days)
// Use this to understand your normal volume before alerting.
// ─────────────────────────────────────────────────────────────
SigninLogs
| where TimeGenerated > ago(7d)
| where AuthenticationProtocol == "deviceCode"
| summarize
    Count = count(),
    Users = make_set(UserPrincipalName),
    Apps  = make_set(AppDisplayName),
    IPs   = make_set(IPAddress)
  by bin(TimeGenerated, 1h)
| order by TimeGenerated desc


// ── QUERY 2 ─────────────────────────────────────────────────
// Suspicious: Device code sign-in from unusual country
// Requires Entra ID P2 / NamedLocations configured
// ─────────────────────────────────────────────────────────────
SigninLogs
| where TimeGenerated > ago(7d)
| where AuthenticationProtocol == "deviceCode"
| where ResultType == 0 // successful
| extend Country = tostring(LocationDetails.countryOrRegion)
| where Country !in ("New Zealand", "Australia") // adjust to your org
| project
    TimeGenerated,
    UserPrincipalName,
    AppDisplayName,
    IPAddress,
    Country,
    ConditionalAccessStatus,
    AuthenticationRequirement


// ── QUERY 3 ─────────────────────────────────────────────────
// High-value: Token used from different IP than sign-in
// Classic indicator of token theft — attacker polls from
// their own IP while victim signs in from theirs.
// ─────────────────────────────────────────────────────────────
let DeviceCodeSignIns = SigninLogs
| where TimeGenerated > ago(1d)
| where AuthenticationProtocol == "deviceCode"
| where ResultType == 0
| project
    CorrelationId,
    SignInTime   = TimeGenerated,
    User         = UserPrincipalName,
    SignInIP     = IPAddress,
    App          = AppDisplayName;

let TokenUsage = AADNonInteractiveUserSignInLogs
| where TimeGenerated > ago(1d)
| project
    CorrelationId,
    TokenUseTime = TimeGenerated,
    TokenUseIP   = IPAddress;

DeviceCodeSignIns
| join kind=inner TokenUsage on CorrelationId
| where SignInIP != TokenUseIP
| extend DeltaMinutes = datetime_diff('minute', TokenUseTime, SignInTime)
| project
    User, App,
    SignInTime, SignInIP,
    TokenUseTime, TokenUseIP,
    DeltaMinutes
| order by SignInTime desc


// ── QUERY 4 ─────────────────────────────────────────────────
// Suspicious OAuth app consent with high-risk scopes
// offline_access + Mail/Files = classic device code phish loot
// ─────────────────────────────────────────────────────────────
AuditLogs
| where TimeGenerated > ago(7d)
| where OperationName == "Consent to application"
| extend
    User        = tostring(InitiatedBy.user.userPrincipalName),
    AppName     = tostring(TargetResources[0].displayName),
    Scopes      = tostring(AdditionalDetails)
| where Scopes has "offline_access"
    and (Scopes has "Mail.Read" or Scopes has "Files.Read" or Scopes has "Mail.ReadWrite")
| project TimeGenerated, User, AppName, Scopes, CorrelationId


// ── QUERY 5 ─────────────────────────────────────────────────
// Bulk mail read after device code auth (exfil indicator)
// Correlates successful device code auth → Graph mail access
// ─────────────────────────────────────────────────────────────
let SuspectUsers = SigninLogs
| where TimeGenerated > ago(1d)
| where AuthenticationProtocol == "deviceCode" and ResultType == 0
| distinct UserPrincipalName;

OfficeActivity
| where TimeGenerated > ago(1d)
| where UserId in (SuspectUsers)
| where Operation in ("MailItemsAccessed", "FileDownloaded", "FileSyncDownloadedFull")
| summarize
    OpCount = count(),
    Ops     = make_set(Operation),
    Items   = make_set(AffectedItems)
  by UserId, bin(TimeGenerated, 15m)
| where OpCount > 50
| order by OpCount desc


// ── QUERY 6 ─────────────────────────────────────────────────
// Alert: First-time device code sign-in for a user
// Most legit users never use device code flow.
// ─────────────────────────────────────────────────────────────
let Lookback    = 30d;
let RecentWin   = 1d;

let HistoricUsers = SigninLogs
| where TimeGenerated between (ago(Lookback) .. ago(RecentWin))
| where AuthenticationProtocol == "deviceCode"
| distinct UserPrincipalName;

SigninLogs
| where TimeGenerated > ago(RecentWin)
| where AuthenticationProtocol == "deviceCode"
| where ResultType == 0
| where UserPrincipalName !in (HistoricUsers)
| project
    TimeGenerated,
    UserPrincipalName,
    AppDisplayName,
    IPAddress,
    ConditionalAccessStatus
| extend Severity = "High"


// ── QUERY 7 ─────────────────────────────────────────────────
// Watchlist: known-abused public client_ids
// These are legitimate Microsoft app IDs commonly used in
// device code phishing because they need no secret.
// ─────────────────────────────────────────────────────────────
let AbusedClientIds = datatable(ClientId: string, AppAlias: string) [
    "04b07795-8ddb-461a-bbee-02f9e1bf7b46", "Microsoft Azure CLI",
    "1950a258-227b-4e31-a9cf-717495945fc2", "Microsoft Azure PowerShell",
    "d3590ed6-52b3-4102-aeff-aad2292ab01c", "Microsoft Office",
    "00000002-0000-0ff1-ce00-000000000000", "Office 365 Exchange Online",
    "29d9ed98-a469-4536-ade2-f981bc1d605e", "Microsoft Authentication Broker",
];

SigninLogs
| where TimeGenerated > ago(7d)
| where AuthenticationProtocol == "deviceCode"
| where ResultType == 0
| lookup kind=inner AbusedClientIds on $left.AppId == $right.ClientId
| project
    TimeGenerated, UserPrincipalName,
    AppAlias, AppDisplayName, AppId,
    IPAddress, ConditionalAccessStatus
| order by TimeGenerated desc


// ── SCHEDULED ALERT TEMPLATE ────────────────────────────────
